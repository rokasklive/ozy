# Bench environment variables — all optional. A clean checkout runs zero-config
# against the default free OpenCode model. Copy to .env only to override.

# Model ID for the live tier. Any model the pinned OpenCode resolves works.
# Default: opencode/big-pickle (steadier than deepseek-v4-flash-free, which stalls
# mid-stream often enough to wedge runs). Other free options the pinned OpenCode
# lists: opencode/deepseek-v4-flash-free, opencode/nemotron-3-ultra-free,
# opencode/hy3-free, opencode/mimo-v2.5-free, opencode/north-mini-code-free.
# BENCH_MODEL=opencode/big-pickle

# Live runs per mode. Precedence: --runs flag > BENCH_RUNS > scenario config > 5.
# BENCH_RUNS=5

# Execution mode: direct, direct-lean, ozy, all, or both.
# MODE=all

# Scenario to run.
# SCENARIO=historical-weather-report

# Hard per-run timeout in seconds (a hung run is recorded as timed_out).
# BENCH_TIMEOUT=600
