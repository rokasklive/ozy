{
  // Ozy downstream config — the historical-weather-report scenario's functional
  // fixture toolsets, the same set direct mode wires. Reference only: setupOzy
  // writes the real downstream config per run from the scenario's server set
  // (corpus included when corpus:true). Functional wiring is asserted by
  // TestModeTemplatesMatchRunner.
  "mcp": {
    "weather": {
      "type": "local",
      "command": ["ozy-bench", "mcp", "--toolset", "weather", "--fixture-dir", "{env:OZY_BENCH_FIXTURE_DIR}"],
      "enabled": true
    },
    "duckduckgo": {
      "type": "local",
      "command": ["ozy-bench", "mcp", "--toolset", "duckduckgo", "--fixture-dir", "{env:OZY_BENCH_FIXTURE_DIR}"],
      "enabled": true
    },
    "wikipedia": {
      "type": "local",
      "command": ["ozy-bench", "mcp", "--toolset", "wikipedia", "--fixture-dir", "{env:OZY_BENCH_FIXTURE_DIR}"],
      "enabled": true
    },
    "pdf-toolkit": {
      "type": "local",
      "command": ["ozy-bench", "mcp", "--toolset", "pdf-toolkit"],
      "enabled": true
    }
  }
}
