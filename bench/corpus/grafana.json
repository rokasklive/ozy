          },
          "text": {
            "description": "Annotation text.",
            "type": "string"
          },
          "time": {
            "description": "Annotation time in ms.",
            "type": "integer"
          }
        },
        "required": [
          "text",
          "time"
        ],
        "type": "object"
      }
    },
