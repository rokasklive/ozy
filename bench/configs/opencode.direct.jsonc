{
  // OpenCode config for DIRECT mode — the historical-weather-report scenario's
  // functional fixture toolsets exposed directly. This template is a reference:
  // the runner writes its own config per run from the scenario's declared server
  // set (the same source), and when the scenario sets corpus:true the ≥500 corpus
  // servers attach on top of these — not enumerated here to keep the reference
  // readable. The wired *functional* server set is asserted against the runner by
  // TestModeTemplatesMatchRunner.
  "mcp": {
    "weather": {
      "type": "local",
      "command": ["ozy-bench", "mcp", "--toolset", "weather", "--fixture-dir", "{env:OZY_BENCH_FIXTURE_DIR}"],
      "enabled": true
    },
    "duckduckgo": {
      "type": "local",
      "command": ["ozy-bench", "mcp", "--toolset", "duckduckgo", "--fixture-dir", "{env:OZY_BENCH_FIXTURE_DIR}"],
      "enabled": true
    },
    "wikipedia": {
      "type": "local",
      "command": ["ozy-bench", "mcp", "--toolset", "wikipedia", "--fixture-dir", "{env:OZY_BENCH_FIXTURE_DIR}"],
      "enabled": true
    },
    "pdf-toolkit": {
      "type": "local",
      "command": ["ozy-bench", "mcp", "--toolset", "pdf-toolkit"],
      "enabled": true
    }
  }
}
